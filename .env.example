# Copy to .env (`make up` does this if .env is missing). Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Used by host-side tools (tests, `make migrate`). docker-compose overrides it for the ingester container.
DATABASE_URL=postgresql+asyncpg://shipwatch:shipwatch@localhost:5432/shipwatch

# Repo whose pull_request webhooks `make forward` and `make sandbox-pr` use (owner/name).
GITHUB_REPO=your-user/your-repo

# Shared secret configured on the GitHub webhook. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The ingester refuses to start with this placeholder or anything under 16 characters.
GITHUB_WEBHOOK_SECRET=change-me
