# Copy to .env (`make up` does this if .env is missing). Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Used by host-side tools (tests, `make migrate`). docker-compose overrides it for the ingester container.
DATABASE_URL=postgresql+asyncpg://shipwatch:shipwatch@localhost:5432/shipwatch

# Repo whose pull_request webhooks `make forward` and `make sandbox-pr` use (owner/name).
GITHUB_REPO=your-user/your-repo

# Shared secret configured on the GitHub webhook. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The ingester refuses to start with this placeholder or anything under 16 characters.
GITHUB_WEBHOOK_SECRET=change-me

# Kafka (Redpanda). Host-side tools use the external listener; docker-compose overrides it for containers.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PR_EVENTS_TOPIC=pr-events
PR_EVENTS_DLQ_TOPIC=pr-events.dlq
PR_VERDICTS_TOPIC=pr-verdicts

# Redis (worker idempotency keys). docker-compose overrides it for containers.
REDIS_URL=redis://localhost:6379/0

# Agent tools: GitHub token for the REST API (read-only; public_repo scope is enough for public repos).
# Optional: without it GitHub allows 60 requests per hour. `gh auth token` prints one you can use locally.
GITHUB_TOKEN=

# PR risk agent (docs/SPEC_W3.md). LLM_PROVIDER is openai, anthropic or groq; LLM_MODEL is required to
# run it (without it every PR gets a needs_review verdict). Prices are USD per million tokens and are
# only used to report cost. Keys: only the chosen provider's is needed.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
LLM_TOKEN_BUDGET=50000

# Agent traces. docker-compose overrides it for containers.
MONGO_URL=mongodb://localhost:27017

# Worker: probability (0..1) that a processing attempt fails on purpose, to exercise retries/DLQ.
FAIL_RATE=0
