/875.\n\n## Test Plan\n\nNew tests in `narrow/conditionals/nested.md`.", "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJokXi4CRC1aQ7uu5UhlAAAF4IQAKdF+/FPonB6vrqS6R9WH2ET\n9dyvybQCl+HjXUKab1cslTI9hVCtQrynhQPh0vTyHJaJ3EkbxCXfAtMCzMEnCgHA\nqyG/MPftvPWSv5alzJ6svVhrRQUu59qTG4CbWhZSuyTtnjt+/c8+vW8QExjVpMXG\nnCQ+y/sPldVu2ZGg1eeSB4q7+FJ9lXsiJP090dxYFcPmmGKgTht0D0zaKKS0M7Tb\nkS2Q5bH3TJGltUIaTbpKvq8tCKSoQMuSDEI9ogj10kPtaeAFcmZtrN/NZplKcCR+\nn3gVPal/dNdMv4qMRYx/+ERSVgeM89zUxgxFj6HX4JyyV7+J41F7+ZudUrgoAU9N\nPcnTO2gxWUFeTJ9SHmVhgd5H4A7VPCJGi4WXfbh0PDvTZQcjYCEAnax3udf34keQ\nU2OTdtaJslyYJbrL5EHM5nBrtsPdYJfG5/XrzVu2BlzfWvhGJHYX5tDmLbIK60br\nR3sFZEKjPRHB4jSO1kgvzGnGqlvLAzt3nvKCn5h4giwOVKEAh6t+Nb1yy7kzUSIR\nSQhzaVwvDOi70pSMlm4rJrsL1VZlwC9DK4cmcW38ITM8fjiogbkc7TCiju8UDWti\n84xktMttu9J81ZgAMUmcgr1QgxffuwxIhYnwSh76lKiEuohbwdoRHsT5dQRrTijC\nBos6413PgpF0e1BWs1r9\n=wnHQ\n-----END PGP SIGNATURE-----\n", "verified": true, "verified_at": "2025-08-05T03:21:28Z"}}, "committer": {"avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "followers_url": "https://api.github.com/users/web-flow/followers", "following_url": "https://api.github.com/users/web-flow/following{/other_user}", "gists_url": "https://api.github.com/users/web-flow/gists{/gist_id}", "gravatar_id": "", "html_url": "https://github.com/web-flow", "id": 19864447, "login": "web-flow", "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "organizations_url": "https://api.github.com/users/web-flow/orgs", "received_events_url": "https://api.github.com/users/web-flow/received_events", "repos_url": "https://api.github.com/users/web-flow/repos", "site_admin": false, "starred_url": "https://api.github.com/users/web-flow/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/web-flow/subscriptions", "type": "User", "url": "https://api.github.com/users/web-flow", "user_view_type": "public"}, "html_url": "https://github.co