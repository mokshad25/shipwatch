following_url": "https://api.github.com/users/web-flow/following{/other_user}", "gists_url": "https://api.github.com/users/web-flow/gists{/gist_id}", "gravatar_id": "", "html_url": "https://github.com/web-flow", "id": 19864447, "login": "web-flow", "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "organizations_url": "https://api.github.com/users/web-flow/orgs", "received_events_url": "https://api.github.com/users/web-flow/received_events", "repos_url": "https://api.github.com/users/web-flow/repos", "site_admin": false, "starred_url": "https://api.github.com/users/web-flow/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/web-flow/subscriptions", "type": "User", "url": "https://api.github.com/users/web-flow", "user_view_type": "public"}, "html_url": "https://github.com/astral-sh/ruff/commit/f51f1f71534a87703ffaa4f8b8e5da8416e0d27c", "node_id": "C_kwDOHy0BzdoAKGY1MWYxZjcxNTM0YTg3NzAzZmZhYTRmOGI4ZTVkYTg0MTZlMGQyN2M", "parents": [{"html_url": "https://github.com/astral-sh/ruff/commit/9b694ada82a78d497f44dd44c95c9b56c4155491", "sha": "9b694ada82a78d497f44dd44c95c9b56c4155491", "url": "https://api.github.com/repos/astral-sh/ruff/commits/9b694ada82a78d497f44dd44c95c9b56c4155491"}], "sha": "f51f1f71534a87703ffaa4f8b8e5da8416e0d27c", "url": "https://api.github.com/repos/astral-sh/ruff/commits/f51f1f71534a87703ffaa4f8b8e5da8416e0d27c"}, {"author": {"avatar_url": "https://avatars.githubusercontent.com/u/36778786?v=4", "events_url": "https://api.github.com/users/ntBre/events{/privacy}", "followers_url": "https://api.github.com/users/ntBre/followers", "following_url": "https://api.github.com/users/ntBre/following{/other_user}", "gists_url": "https://api.github.com/users/ntBre/gists{/gist_id}", "gravatar_id": "", "html_url": "https://github.com/ntBre", "id": 36778786, "login": "ntBre", "node_id": "MDQ6VXNlcjM2Nzc4Nzg2", "organizations_url": "https://api.github.com/users/ntBre/orgs", "received_events_url": "https://api.github.com/users/ntBre/received_events", "repos_url": "https://api.github.com/users/ntBre/repos", "site_admin": false, "starred_url": "https://api.github.com/users/ntBre/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ntBre/subscriptions", "type": "User", "url": "https://api.github.com/users/ntBre", "user_view_type": "public"}, "comments_url": "https://api.github.com/repos/astral-sh/ruff/commits/57bf7dfbd9f0c2e25532f66bca2818d1503967c0/comments", "commit": {"author": {"date": "2025-05-08T14:30:04Z", "email": "36778786+ntBre@users.noreply.github.com", "name": "Brent Westbrook"}, "comment_count": 0, "committer": {"date": "2025-05-08T14:30:04Z", "email": "noreply@github.com", "name": "GitHub"}, "message": "[ty] Implement `global` handling and `load-before-global-declaration` syntax error (#17637)\n\nSummary\n--\n\nThis PR resolves both the typing-related and syntax error TODOs added in\n#17563 by tracking a set of `global` bindings for each scope. As\ndiscussed below, we avoid the additional AST traversal from ruff by\ncollecting `Name`s from `global` statements while building the semantic\nindex and emit a syntax error if the `Name` is already bound in the\ncurrent scope at the point of the `global` statement. This has the\ndownside of separating the error from the `SemanticSyntaxChecker`, but I\nplan to explore using this approach in the `SemanticSyntaxChecker`\nitself as a follow-up. It seems like this may be a better approach for\nruff as well.\n\nTest Plan\n--\n\nUpdated all of the related mdtests to remove the TODOs (and add quotes I\nforgot on the messages).\n\nThere is one remaining TODO, but it requires `nonlocal` support, which\nisn't even incorporated into the `SemanticSyntaxChecker` yet.\n\n---------\n\nCo-authored-by: Alex Waygood <Alex.Waygood@Gmail.com>\nCo-authored-by: Carl Meyer <carl@astral.sh>", "tree": {"sha": "e0360e3e0b19d9e6da5bc05fd0e882b736fe2697", "url": "https://api.github.com/repos/astral-sh/ruff/git/trees/e0360e3e0b19d9e6da5bc05fd0e882b736fe2697"}, "url": "https://api.github.com/repos/astral-sh/ruff/git/commits/57bf7dfbd9f0c2e25532f66bca2818d1503967c0", "verification": {"payload": "tree e0360e3e0b19d9e6da5bc05fd0e882b736fe2697\nparent 67cd94ed643a37ef51bd40c057848184b5249ba4\nauthor Brent Westbrook <36778786+ntBre@users.noreply.github.com> 1746714604 -0400\ncommitter GitHub <noreply@github.com> 1746714604 -0400\n\n[ty] Implement `global` handling and `load-before-global-declaration` syntax error (#17637)\n\nSummary\n--\n\nThis PR resolves both the typing-related and syntax error TODOs added in\n#17563 by tracking a set of `global` bindings for each scope. As\ndiscussed below, we avoid the additional AST traversal from ruff by\ncollecting `Name`s from `global` statements while building the semantic\nindex and emit a syntax error if the `Name` is already bound in the\ncurrent scope at the point of the `global` statement. This has the\ndownside of separating the error from the `SemanticSyntaxChecker`, but I\nplan to explore using this approach in the `SemanticSyntaxChecker`\nitself as a follow-up. It seems like this may be a better approach for\nruff as well.\n\nTest Plan\n--\n\nUpdated all of the related mdtests to remove the TODOs (and add quotes I\nforgot on the messages).\n\nThere is one remaining TODO, but it requires `nonlocal` support, which\nisn't even incorporated into the `SemanticSyntaxChecker` yet.\n\n---------\n\nCo-authored-by: Alex Waygood <Alex.Waygood@Gmail.com>\nCo-authored-by: Carl Meyer <carl@astral.sh>", "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJoHL/sCRC1aQ7uu5UhlAAAvWIQAJXPzi2f84vEQNcHFFn7rsio\n9btFWWHc5gybPUitnmNQ9POGYeO3EBDGov7qwrJD91SWEhVIdYjR3tAz+xN9qwWn\njzBF2dxhyUGGQAUlu0MTDTe5eAtnRTB1EK3ujI97GQKbGolhTojs604dqHOEYj+p\nycdIvBh5c2J81d7OyfiAxzfSezgb8rDS22Njumju3Qoc3lSKLulQnXLSV7QaYs4b\nG3HCk3mhxaaWH48QPiu6WTe+CEf/hXWk7PRs5uKhRZfxCS4Znu+dViOiUOmQmjtu\n8fEhdENH0KdZh1DQPLSU11ump6C7j+HapLjlg76MRJUXMECBWiyu367OW92lujH4\nsx3FSK6aRppAoZKtHE3OegXc/HYS4MvkxhAUDZy8yUqlaRq