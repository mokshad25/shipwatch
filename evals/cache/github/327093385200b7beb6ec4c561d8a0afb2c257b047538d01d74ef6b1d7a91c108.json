ithub.com/users/DouweM/received_events", "repos_url": "https://api.github.com/users/DouweM/repos", "site_admin": false, "starred_url": "https://api.github.com/users/DouweM/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DouweM/subscriptions", "type": "User", "url": "https://api.github.com/users/DouweM", "user_view_type": "public"}}, {"active_lock_reason": null, "assignee": null, "assignees": [], "author_association": "CONTRIBUTOR", "body": "<!-- Thank you for your contribution! -->\r\n<!-- Unless your change is trivial, please create an issue to discuss the change before creating a PR -->\r\n\r\n## Change Summary\r\n\r\n`BaseModel.model_rebuild` already ensured that `__pydantic_fields_complete__` was `True` before marking the model as complete, including rebuilding model fields to 1) see if any unknown annotations could not be resolved, and 2) if not, to make sure that the mock error message includes the name of the unknown annotation.\r\n\r\nWe now do the same on `ModelMetaclass.__new__`, to make sure that subclasses of incomplete superclasses don't incorrectly get marked as complete.\r\n\r\nHere is such an example:\r\n\r\n```python\r\nclass MyModel(BaseModel):\r\n    sub_models: list['SubModel']\r\n\r\nclass SubModel(MyModel):\r\n    pass\r\n```\r\n\r\n## Related issue number\r\n\r\nPreparation for https://github.com/pydantic/pydantic/issues/11453\r\n\r\nEdit: fixes https://github.com/pydantic/pydantic/issues/12061.\r\n\r\n## Checklist\r\n\r\n* [x] The pull request title is a good summary of the changes - it will be used in the changelog\r\n* [x] Unit tests for the changes exist\r\n* [x] Tests pass on CI\r\n* [x] Documentation reflects the changes where applicable\r\n* [x] My PR is ready to review, **please add a comment including the phrase \"please review\" to assign reviewers**\r\n\r\n\r\nSelected Reviewer: @sydney-runkle", "closed_at": "2025-04-17T20:05:48Z", "comments": 8, "comments_url": "https://api.github.com/repos/pydantic/pydantic/issues/11759/comments", "created_at": "2025-04-15T21:43:28Z", "draft": false, "events_url": "https://api.github.com/repos/pydantic/pydantic/issues/11759/events", "html_url": "https://github.com/pydantic/pydantic/pull/11759", "id": 2997707038, "issue_field_values": [], "labels": [{"archived_at": null, "archived_by": null, "color": "429BE2", "default": false, "description": "Used for bugfixes.", "id": 5991216229, "name": "relnotes-fix", "node_id": "LA_kwDOBWBCuM8AAAABZRq0ZQ", "url": "https://api.github.com/repos/pydantic/pydantic/labels/relnotes-fix"}, {"archived_at": null, "archived_by": null, "color": "7D108A", "default": false, "description": "Add this label on a PR to trigger 3rd party tests", "id": 7835260906, "name": "third-party-tests", "node_id": "LA_kwDOBWBCuM8AAAAB0wSX6g", "url": "https://api.github.com/repos/pydantic/pydantic/labels/third-party-tests"}], "labels_url": "https://api.github.com/repos/pydantic/pydantic/issues/11759/labels{/name}", "locked": false, "milestone": null, "node_id": "PR_kwDOBWBCuM6SvNfU", "number": 11759, "performed_via_github_app": null, "pull_request": {"diff_url": "https://github.com/pydantic/pydantic/pull/11759.diff", "html_url": "https://github.com/pydantic/pydantic/pull/11759", "merged_at": "2025-04-17T20:05:48Z", "patch_url": "https://github.com/pydantic/pydantic/pull/11759.patch", "url": "https://api.github.com/repos/pydantic/pydantic/pulls/11759"}, "reactions": {"+1": 0, "-1": 0, "confused": 0, "eyes": 0, "heart": 0, "hooray": 0, "laugh": 0, "rocket": 0, "total_count": 0, "url": "https://api.github.com/repos/pydantic/pydantic/issues/11759/reactions"}, "repository_url": "https://api.github.com/repos/pydantic/pydantic", "score": 1.0, "state": "closed", "state_reason": null, "timeline_url": "https://api.github.com/repos/pydantic/pydantic/issues/11759/timeline", "title": "Only mark model as complete once all fields are complete", "type": null, "updated_at": "2025-07-20T09:03:28Z", "url": "https://api.github.com/repos/pydant